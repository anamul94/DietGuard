# ======================
# Database Configuration
# ======================
DATABASE_URL=postgresql+asyncpg://dietguard:dietguard123@localhost:5432/dietguard
POSTGRES_USER=dietguard
POSTGRES_PASSWORD=dietguard123
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=dietguard

# ======================
# JWT Configuration
# ======================
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ======================
# Security
# ======================
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=1
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_MINUTES=15

# ======================
# HIPAA Encryption (REQUIRED)
# ======================
# Generate a secure key using: python scripts/generate_encryption_key.py
# This key is used for encrypting patient PII data
# NEVER commit this key to version control
# Use different keys for dev/staging/production
ENCRYPTION_KEY=your-base64-encoded-32-byte-encryption-key-here

# ======================
# Subscription Limits
# ======================
FREE_TIER_DAILY_UPLOAD_LIMIT=2
FREE_TIER_DAILY_NUTRITION_LIMIT=2

# ======================
# AWS Configuration (for LLM)
# ======================
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_SESSION_TOKEN=your_aws_session_token_if_using_temporary_credentials
AWS_PROFILE=your_aws_profile_name_if_using_shared_credentials
AWS_REGION=ap-south-1
BEDROCK_MODEL_ID=optional_explicit_model_or_inference_profile_id

# Global Anthropic Claude Sonnet 4.6 Model Configuration
INFERENCE_PROFILE_ARN=arn:aws:bedrock:ap-south-1:686255973607:inference-profile/global.anthropic.claude-sonnet-4-6

# AWS Transcribe (for Mood Check-ins)
# Backend uploads audio to S3 (private), starts a Transcribe job, fetches the transcript,
# then deletes the S3 object immediately after transcription for privacy.
TRANSCRIBE_S3_BUCKET=your_private_bucket_name
TRANSCRIBE_S3_PREFIX=mood-checkins/
TRANSCRIBE_LANGUAGE_CODE=en-US
TRANSCRIBE_TIMEOUT_SECONDS=180
TRANSCRIBE_POLL_INTERVAL_SECONDS=2
MAX_MOOD_AUDIO_MB=12
INFERENCE_PROFILE_ID=global.anthropic.claude-sonnet-4-6

# ======================
# LLM / Agent Configuration (Centralized)
# ======================
# Configure the default provider/model for all agents and override per agent when needed.
LLM_PROVIDER=bedrock
LLM_MODEL=apac.anthropic.claude-3-7-sonnet-20250219-v1:0
LLM_DEBUG_LOG_PROMPTS=false
LLM_DEBUG_MAX_CHARS=4000

# Per-agent overrides (override the global settings above).
# Define both `_LLM_PROVIDER` and `_LLM_MODEL` together for consistency.
DIET_PLAN_AGENT_LLM_PROVIDER=ollama
DIET_PLAN_AGENT_LLM_MODEL=glm-4.7-flash:latest
DAILY_SUMMARY_AGENT_LLM_PROVIDER=bedrock
DAILY_SUMMARY_AGENT_LLM_MODEL=apac.anthropic.claude-3-7-sonnet-20250219-v1:0
FOOD_AGENT_LLM_PROVIDER=bedrock
FOOD_AGENT_LLM_MODEL=apac.anthropic.claude-3-7-sonnet-20250219-v1:0
INGREDIENT_SCANNER_AGENT_LLM_PROVIDER=bedrock
INGREDIENT_SCANNER_AGENT_LLM_MODEL=apac.anthropic.claude-3-7-sonnet-20250219-v1:0
NUTRITION_CALCULATOR_AGENT_LLM_PROVIDER=bedrock
NUTRITION_CALCULATOR_AGENT_LLM_MODEL=apac.anthropic.claude-3-7-sonnet-20250219-v1:0
NUTRITIONIST_AGENT_LLM_PROVIDER=bedrock
NUTRITIONIST_AGENT_LLM_MODEL=apac.anthropic.claude-3-7-sonnet-20250219-v1:0
REPORT_AGENT_LLM_PROVIDER=bedrock
REPORT_AGENT_LLM_MODEL=apac.anthropic.claude-3-7-sonnet-20250219-v1:0
REPORT_MERGE_AGENT_LLM_PROVIDER=bedrock
REPORT_MERGE_AGENT_LLM_MODEL=apac.anthropic.claude-3-7-sonnet-20250219-v1:0
SUMMARY_AGENT_LLM_PROVIDER=bedrock
SUMMARY_AGENT_LLM_MODEL=apac.anthropic.claude-3-7-sonnet-20250219-v1:0
MOOD_CHECKIN_AGENT_LLM_PROVIDER=bedrock
MOOD_CHECKIN_AGENT_LLM_MODEL=apac.anthropic.claude-3-7-sonnet-20250219-v1:0

# ======================
# Langfuse (Optional - for LLM observability)
# ======================

# ======================
# Application Settings
# ======================
APP_NAME=DietGuard
DEBUG=True
LOG_LEVEL=INFO

# ======================
# Email (Future Implementation)
# ======================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# FROM_EMAIL=noreply@dietguard.com
